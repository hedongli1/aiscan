    },
    {
      "file": "xss-jquery.js",
      "category": "xss",
      "title": "jQuery DOM XSS",
      "expected": [
        {
          "line": 3,
          "ruleId": "XSS-JQUERY-HTML",
          "reason": "$('#list').html(comment.body)"
