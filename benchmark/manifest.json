  ],
  "tolerances": {
    "_note": "真实性评分：precision = TP/(TP+FP)；recall = TP/(TP+FN)。TP=期望命中且命中；FP=不应命中却命中；FN=期望命中却未命中。整体分数=R(recall) 与 P(precision) 的调和均值（F1）。",
    "gradeThresholds": {
      "excellent": 0.95,
      "good": 0.85,
      "fair": 0.7,
      "poor": 0.0
    }
  }
}