        },
        {
          "line": 9,
          "ruleId": "XSS-JQUERY-HTML",
          "reason": ".text() 安全"
        }
      ]
    },
    {
      "file": "xss-vue-vhtml.js",
      "category": "xss",
      "title": "Vue v-html",
      "expected": [
        {
          "line": 4,
          "ruleId": "XSS-VUE-VHTML",
