# aiscan 忽略清单（类似 .gitignore）
# 这些文件包含安全术语字符串，属于规则定义/测试数据，不应视为泄漏。

# 规则库本身包含弱加密/密钥等关键字的文本描述（自指误报）
rules/index.js
lib/rules/index.js

# gitleaks 移植规则文件：内容即密钥正则模式（自指误报）
gitleaks.js
lib/rules/gitleaks.js

# 转换工具读写的规则源文件
tools/

# 测试与演示数据
test/
fixtures/

# 扫描器自身的受控文件遍历（路径来自 walk，非用户输入）
scanner.js
lib/scanner.js

# CLI 代码里的环境变量名引用（process.env.GITHUB_TOKEN 是读取而非泄漏）
aiscan.js
bin/aiscan.js


# 生成的安全报告（内容为 demo 漏洞检测结果）
security-report.html

# 文档中的示例代码片段（讲的就是这些漏洞）
README.md
action.yml
.github/ISSUE_TEMPLATE/new_rule.md

# patrol 代码里的受控克隆与示例 token 引用
patrol.js
lib/patrol.js

# 熵模块文档字符串中的示例令牌
entropy.js
lib/entropy.js

# patrol workflow 引用 secrets.PATROL_TOKEN/GITHUB_TOKEN 是读取环境变量（非泄漏）
patrol.yml
.github/workflows/patrol.yml
